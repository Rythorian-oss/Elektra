<Window x:Class="Elektra.UI.LearningReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review Local Learning Data"
        Width="900"
        Height="520"
        MinWidth="650"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="#FF0F172A"
        Foreground="#FFF8FAFC">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Local learning records" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="These records stay on this device. Select a row to delete only that record." Foreground="#FF94A3B8" Margin="0,4,0,0" />
        </StackPanel>
        <DataGrid x:Name="LearningRecordsGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  Background="#FF111827"
                  Foreground="#FFF8FAFC"
                  RowBackground="#FF172033"
                  AlternatingRowBackground="#FF1E293B"
                  BorderBrush="#FF334155">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="145" />
                <DataGridTextColumn Header="Phrase / key" Binding="{Binding Query}" Width="2*" />
                <DataGridTextColumn Header="Saved value" Binding="{Binding Value}" Width="2*" />
                <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="110" />
                <DataGridTextColumn Header="Updated" Binding="{Binding CreatedAtUtc, StringFormat={}{0:g}}" Width="130" />
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="ReviewStatusText" VerticalAlignment="Center" Foreground="#FF93C5FD" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Refresh" Padding="12,6" Margin="0,0,8,0" Click="OnRefreshClicked" />
                <Button Content="Delete selected" Padding="12,6" Margin="0,0,8,0" Click="OnDeleteClicked" />
                <Button Content="Close" Padding="12,6" Click="OnCloseClicked" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
