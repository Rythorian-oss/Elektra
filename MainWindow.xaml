<Window x:Class="Elektra.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Elektra.UI.Controls"
        Title="Elektra"
        Width="360" Height="510"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Opacity="0"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Copy"
                        CanExecute="OnCanExecuteCopyAnswer"
                        Executed="OnExecuteCopyAnswer" />
    </Window.CommandBindings>

    <Grid x:Name="RootContainer"
          RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="OrbScaleTransform" ScaleX="0.88" ScaleY="0.88" />
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="260" />
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PlasmaSphereControl x:Name="PlasmaOrb"
                                      Grid.Row="0"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      MouseLeftButtonDown="OnOrbMouseLeftButtonDown" />

        <Button x:Name="OpenLocationSearchButton"
                Grid.Row="1"
                Margin="36,0,36,4"
                Cursor="Hand"
                ToolTip="Type a location to find in Google Earth"
                Click="OnOpenLocationSearchClicked">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="SearchButtonSurface"
                            Background="#DD101C31"
                            BorderBrush="#6656DDFB"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="⌖" Foreground="#67E8F9" FontSize="18" Margin="0,-2,7,0" />
                            <TextBlock Text="SEARCH GOOGLE EARTH" Foreground="#E0F2FE" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SearchButtonSurface" Property="Background" Value="#EE12304A" />
                            <Setter TargetName="SearchButtonSurface" Property="BorderBrush" Value="#FF67E8F9" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="SearchButtonSurface" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Border x:Name="LocationSearchHud"
                Grid.Row="2"
                Margin="10,0,10,10"
                Padding="16,13"
                CornerRadius="18"
                Background="#F20B1426"
                BorderBrush="#8846D9F5"
                BorderThickness="1"
                Opacity="0"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect Color="#FF22D3EE" BlurRadius="20" ShadowDepth="0" Opacity="0.22" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="EXPLORE A LOCATION"
                                   Foreground="#E0F2FE"
                                   FontSize="13"
                                   FontWeight="Bold" />
                        <TextBlock Text="Search by place name or full street address"
                                   Foreground="#94A3B8"
                                   FontSize="10"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Width="28" Height="28"
                            Content="×"
                            Foreground="#A5B4C7"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="20"
                            Cursor="Hand"
                            ToolTip="Close location search"
                            Click="OnCloseLocationSearchClicked" />
                </Grid>
                <TextBox x:Name="LocationSearchTextBox"
                         Grid.Row="1"
                         Height="38"
                         Margin="0,8,0,0"
                         Padding="11,8"
                         Background="#CC07101F"
                         Foreground="#F8FAFC"
                         CaretBrush="#67E8F9"
                         BorderBrush="#556B829F"
                         BorderThickness="1"
                         FontSize="13"
                         VerticalContentAlignment="Center"
                         ToolTip="Example: 60 Elm Street, Waterville, Maine"
                         AutomationProperties.Name="Location or address"
                         PreviewKeyDown="OnLocationSearchKeyDown" />
                <TextBlock x:Name="LocationSearchStatusText"
                           Grid.Row="2"
                           Foreground="#93C5FD"
                           FontSize="10"
                           Text="Your location is sent to the configured geocoding provider."
                           TextWrapping="Wrap"
                           Margin="1,7,1,7" />
                <Grid Grid.Row="3" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="Cancel"
                            Padding="14,7"
                            Margin="0,0,8,0"
                            Background="#221E293B"
                            Foreground="#CBD5E1"
                            BorderBrush="#5547556B"
                            BorderThickness="1"
                            Cursor="Hand"
                            Click="OnCloseLocationSearchClicked" />
                    <Button x:Name="SearchLocationButton"
                            Grid.Column="1"
                            Content="Find in Google Earth"
                            Padding="14,7"
                            Background="#FF0E7490"
                            Foreground="White"
                            BorderBrush="#FF22D3EE"
                            BorderThickness="1"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="OnSearchLocationClicked" />
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="ResponseHud"
                Grid.Row="2"
                Margin="12,4,12,12"
                Padding="14,10"
                CornerRadius="16"
                Background="#DD0F172A"
                BorderBrush="#5538BDF8"
                BorderThickness="1"
                Opacity="0"
                IsHitTestVisible="False"
                Visibility="Collapsed"
                MouseEnter="OnHudMouseEnter"
                MouseLeave="OnHudMouseLeave">
            <Border.RenderTransform>
                <TranslateTransform x:Name="HudSlideTransform" Y="12" />
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="QueryText"
                               Grid.Column="0"
                               Foreground="#94A3B8"
                               FontSize="11"
                               FontStyle="Italic"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <Button x:Name="CopyAnswerButton"
                            Grid.Column="1"
                            Width="24" Height="24"
                            Margin="8,0,0,0"
                            Cursor="Hand"
                            Focusable="False"
                            ToolTip="Copy answer (Ctrl+C)"
                            Click="OnCopyAnswerClicked">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BtnSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="4">
                                    <Grid>
                                        <Path x:Name="CopyIcon"
                                              Data="M 4,4 L 4,1.5 C 4,0.7 4.7,0 5.5,0 L 12.5,0 C 13.3,0 14,0.7 14,1.5 L 14,8.5 C 14,9.3 13.3,10 12.5,10 L 10,10 M 1.5,4 L 8.5,4 C 9.3,4 10,4.7 10,5.5 L 10,12.5 C 10,13.3 9.3,14 8.5,14 L 1.5,14 C 0.7,14 0,13.3 0,12.5 L 0,5.5 C 0,4.7 0.7,4 1.5,4 Z"
                                              Stroke="#94A3B8" StrokeThickness="1.3" Stretch="Uniform" Width="13" Height="13" />
                                        <Path x:Name="CheckIcon"
                                              Data="M 1.5,7.5 L 5.5,11.5 L 12.5,2.5"
                                              Stroke="#34D399" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Stretch="Uniform" Width="13" Height="13" Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnSurface" Property="Background" Value="#2638BDF8" />
                                        <Setter TargetName="BtnSurface" Property="BorderBrush" Value="#5538BDF8" />
                                        <Setter TargetName="CopyIcon" Property="Stroke" Value="#F8FAFC" />
                                    </Trigger>
                                    <Trigger Property="Tag" Value="Copied">
                                        <Setter TargetName="CopyIcon" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="BtnSurface" Property="Background" Value="#2210B981" />
                                        <Setter TargetName="BtnSurface" Property="BorderBrush" Value="#6634D399" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="CloseAnswerButton"
                            Grid.Column="2"
                            Width="24" Height="24"
                            Margin="4,0,0,0"
                            Cursor="Hand"
                            Focusable="False"
                            ToolTip="Dismiss (Esc)"
                            Click="OnCloseAnswerClicked">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="CloseSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="5">
                                    <Path x:Name="CloseIcon"
                                          Data="M 1.5,1.5 L 10.5,10.5 M 10.5,1.5 L 1.5,10.5"
                                          Stroke="#94A3B8" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Stretch="Uniform" Width="11" Height="11" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CloseSurface" Property="Background" Value="#26F43F5E" />
                                        <Setter TargetName="CloseSurface" Property="BorderBrush" Value="#66FB7185" />
                                        <Setter TargetName="CloseIcon" Property="Stroke" Value="#FDA4AF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              PanningMode="VerticalOnly"
                              MaxHeight="165">
                    <StackPanel>
                        <TextBlock x:Name="AnswerText"
                                   Foreground="#F8FAFC"
                                   FontSize="13"
                                   TextWrapping="Wrap" />
                        <StackPanel x:Name="FeedbackPanel" Visibility="Collapsed" Margin="0,8,0,0">
                            <CheckBox x:Name="EnableLearningCheckBox"
                                      Content="Allow local learning (off by default)"
                                      Foreground="#CBD5E1"
                                      FontSize="10"
                                      Checked="OnLearningConsentChanged"
                                      Unchecked="OnLearningConsentChanged" />
                            <CheckBox x:Name="PauseTrainingCheckBox"
                                      Content="Pause automatic model training"
                                      Foreground="#CBD5E1"
                                      FontSize="10"
                                      Margin="0,3,0,0"
                                      Checked="OnTrainingPauseChanged"
                                      Unchecked="OnTrainingPauseChanged" />
                            <CheckBox x:Name="EnableVoiceSamplesCheckBox"
                                      Content="Allow local voice samples for Vosk (off by default)"
                                      ToolTip="Stores up to 15 seconds of recognized speech locally with your verified transcript. Separate consent; no audio is uploaded."
                                      Foreground="#FCD9A8"
                                      FontSize="10"
                                      Margin="0,3,0,0"
                                      Checked="OnVoiceSampleConsentChanged"
                                      Unchecked="OnVoiceSampleConsentChanged" />
                            <StackPanel x:Name="FeedbackActionsPanel" Orientation="Horizontal" Margin="0,5,0,0">
                                <Button Content="That worked"
                                        Padding="8,4"
                                        Margin="0,0,6,0"
                                        Background="#2210B981"
                                        Foreground="#D1FAE5"
                                        BorderBrush="#5566DDAA"
                                        Cursor="Hand"
                                        Click="OnWorkedFeedbackClicked" />
                                <Button Content="I meant…"
                                        Padding="8,4"
                                        Background="#222563EB"
                                        Foreground="#DBEAFE"
                                        BorderBrush="#5560A5FA"
                                        Cursor="Hand"
                                        Click="OnCorrectionClicked" />
                                <Button Content="That didn't help"
                                        Padding="8,4"
                                        Background="#223F1D2D"
                                        Foreground="#FECDD3"
                                        BorderBrush="#55FB7185"
                                        Cursor="Hand"
                                        Click="OnNegativeFeedbackClicked" />
                            </StackPanel>
                            <StackPanel x:Name="CorrectionPanel" Visibility="Collapsed" Margin="0,5,0,0">
                                <ComboBox x:Name="CorrectionIntentComboBox" SelectedIndex="0" Height="26" Margin="0,0,0,4">
                                    <ComboBoxItem Content="Knowledge question" />
                                    <ComboBoxItem Content="Location search" />
                                    <ComboBoxItem Content="Speech transcript correction" />
                                </ComboBox>
                                <TextBox x:Name="CorrectionTextBox"
                                         Height="28"
                                         Padding="6,4"
                                         ToolTip="Enter the corrected request or place name" />
                                <Button Content="Save correction"
                                        HorizontalAlignment="Right"
                                        Padding="8,4"
                                        Margin="0,4,0,0"
                                        Background="#222563EB"
                                        Foreground="#DBEAFE"
                                        BorderBrush="#5560A5FA"
                                        Cursor="Hand"
                                        Click="OnSaveCorrectionClicked" />
                            </StackPanel>
                            <TextBlock x:Name="LearningStatusText"
                                       Foreground="#93C5FD"
                                       FontSize="9"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Text="Weather units" Foreground="#CBD5E1" FontSize="10" />
                                <ComboBox x:Name="UnitsPreferenceComboBox" Height="25" Margin="0,3,0,4" SelectionChanged="OnPreferredUnitsChanged">
                                    <ComboBoxItem Content="Use Fahrenheit by default" Tag="Imperial" />
                                    <ComboBoxItem Content="Use Celsius by default" Tag="Metric" />
                                </ComboBox>
                                <TextBlock Text="Explicit local memory" Foreground="#CBD5E1" FontSize="10" />
                                <TextBox x:Name="MemoryKeyTextBox" Height="25" Margin="0,3,0,2" ToolTip="Memory topic or key" />
                                <TextBox x:Name="MemoryValueTextBox" Height="25" Margin="0,0,0,3" ToolTip="What Elektra should remember" />
                                <Button Content="Remember locally"
                                        HorizontalAlignment="Left"
                                        Padding="7,3"
                                        Background="#221E293B"
                                        Foreground="#CBD5E1"
                                        BorderBrush="#5547556B"
                                        Cursor="Hand"
                                        Click="OnSaveMemoryClicked" />
                                <ListBox x:Name="LearningMemoriesList" MaxHeight="72" Margin="0,4,0,0" DisplayMemberPath="Key" />
                                <Button Content="Delete selected memory"
                                        HorizontalAlignment="Left"
                                        Padding="7,3"
                                        Margin="0,3,0,0"
                                        Background="#223F1D2D"
                                        Foreground="#FECDD3"
                                        BorderBrush="#55FB7185"
                                        Cursor="Hand"
                                        Click="OnDeleteMemoryClicked" />
                                <Button Content="Review all learning data"
                                        HorizontalAlignment="Left"
                                        Padding="7,3"
                                        Margin="0,3,0,0"
                                        Background="#221E293B"
                                        Foreground="#CBD5E1"
                                        BorderBrush="#5547556B"
                                        Cursor="Hand"
                                        Click="OnReviewLearningClicked" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <Button Content="Roll back model"
                                        Padding="6,3"
                                        Margin="0,0,6,0"
                                        Background="#221E293B"
                                        Foreground="#CBD5E1"
                                        BorderBrush="#5547556B"
                                        Cursor="Hand"
                                        Click="OnRollbackLearningClicked" />
                                <Button Content="Clear learned data"
                                        Padding="6,3"
                                        Background="#223F1D2D"
                                        Foreground="#FECDD3"
                                        BorderBrush="#55FB7185"
                                        Cursor="Hand"
                                        Click="OnClearLearningClicked" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>