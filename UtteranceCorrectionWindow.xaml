<Window x:Class="Elektra.UI.UtteranceCorrectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Correct recognized question"
        Width="520"
        SizeToContent="Height"
        MaxHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">
    <Border Padding="26"
            CornerRadius="22"
            Background="#F20B1426"
            BorderBrush="#FF22D3EE"
            BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect Color="#FF22D3EE" BlurRadius="28" ShadowDepth="0" Opacity="0.25" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="WHAT DID YOU MEAN?"
                       Foreground="#FF67E8F9"
                       FontSize="11"
                       FontWeight="Bold" />
            <TextBlock x:Name="RecognizedText"
                       Grid.Row="1"
                       Margin="0,10,0,14"
                       Foreground="#FFCBD5E1"
                       TextWrapping="Wrap" />
            <TextBox x:Name="CorrectionInput"
                     Grid.Row="2"
                     MinHeight="42"
                     MaxHeight="180"
                     MaxLength="500"
                     Padding="11,9"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Background="#FF101A2E"
                     Foreground="White"
                     CaretBrush="#FF67E8F9"
                     BorderBrush="#FF46536B"
                     BorderThickness="1"
                     FontSize="14"
                     AutomationProperties.Name="Corrected question" />
            <StackPanel Grid.Row="3"
                        Margin="0,20,0,0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="CANCEL"
                        Width="100"
                        Height="38"
                        Margin="0,0,10,0"
                        Background="#FF1D293D"
                        Foreground="#FFE2E8F0"
                        BorderThickness="0"
                        IsCancel="True" />
                <Button Content="USE CORRECTION"
                        Width="150"
                        Height="38"
                        Background="#FF0E7490"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        IsDefault="True"
                        Click="OnUseCorrectionClicked" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
